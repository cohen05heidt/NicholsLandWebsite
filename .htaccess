# nicholsland.net
#
# One address, one protocol. www and plain http are permanent redirects to
# https://nicholsland.net, so the same page is never reachable at four
# different spellings of its own name.
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The contact form’s credentials. config.php holds the database password and
# the Resend API key, and it is the one file on this server whose exposure
# would actually cost something: the key lets a stranger send mail as
# nicholsland.net. It is in .gitignore so it never reaches the repository, and
# denied here so that even if the PHP handler is ever misconfigured — an
# upgrade that stops parsing .php, a stray rename — it is served as nothing
# rather than as readable text.
<Files "config.php">
  Require all denied
</Files>
<Files "config.example.php">
  Require all denied
</Files>

# The build scripts, the contact-form worker source and the deploy helpers are
# in the repository because that is where they belong, not because anyone
# should be able to download them off the live site.
RedirectMatch 404 ^/(tools|worker)/
  RedirectMatch 404 \.(bat|mjs)$
RedirectMatch 404 ^/[A-Z][A-Z-]*\.md$
  
